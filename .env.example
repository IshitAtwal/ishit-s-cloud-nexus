# Copy to .env for local development; set the same variables in Netlify for production
# (Site configuration → Environment variables). Never commit the real .env.

# Gmail account that sends the contact-form emails.
GMAIL_USER=ishitatwal20@gmail.com

# A Google *app password* (16 characters), not your normal Gmail password.
# Create one at https://myaccount.google.com/apppasswords (requires 2-Step Verification).
GMAIL_APP_PASSWORD=

# Optional: where messages are delivered. Defaults to ishitatwal20@gmail.com.
CONTACT_TO=ishitatwal20@gmail.com
